{:deps        {org.clojure/clojure                     {:mvn/version "1.12.5"}
               org.clojure/tools.deps                  {:mvn/version "0.31.1642"}
               org.clojure/tools.deps.edn              {:mvn/version "0.9.48"}
               org.clojure/tools.logging               {:mvn/version "1.3.1"}
               borkdude/edamame                        {:mvn/version "1.6.43"}
               ch.qos.logback/logback-classic          {:mvn/version "1.6.1"}
               cheshire/cheshire                       {:mvn/version "6.2.0"}
               clj-http/clj-http                       {:mvn/version "3.13.1"}
               org.apache.logging.log4j/log4j-to-slf4j {:mvn/version "2.26.1"}
               org.babashka/cli                        {:mvn/version "0.12.86"}
               org.owasp/dependency-check-core         {:mvn/version "13.0.0"}
               org.slf4j/slf4j-api                     {:mvn/version "2.0.18"}
               selmer/selmer                           {:mvn/version "1.13.5"}
               org.apache.maven/maven-artifact         {:mvn/version "3.9.16"}}

 :paths       ["src" "resources"]

 :tools/usage {:ns-default clj-watson.entrypoint}

 :aliases     {:nREPL       {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}}
               :outdated    {:deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}
                                    org.slf4j/slf4j-simple {:mvn/version "2.0.18"}} ;; to rid ourselves of logger warnings
                             :main-opts ["-m" "antq.core"]}
               :clojure-lsp {:replace-deps {com.github.clojure-lsp/clojure-lsp-standalone
                                            {:mvn/version "2026.07.06-14.34.19"}}
                             :main-opts    ["-m" "clojure-lsp.main"]}
               :test        {:extra-paths ["test"]
                             :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                                          nubank/matcher-combinators {:mvn/version "3.11.0"}
                                          babashka/process {:mvn/version "0.6.25"}
                                          babashka/fs {:mvn/version "0.5.34"}}
                             :main-opts   ["-m" "kaocha.runner" "--reporter" "documentation"]}

               :create-settings-test {:exec-fn clj-watson.unit.controller.dependency-check.scanner-test/create-settings-test-entrypoint}
               :create-settings-test-resources {:extra-paths ["target/create-settings-test"]}

               ;; for dev: so we can run the recommended command from the README:
               :clj-watson {:replace-deps {io.github.clj-holmes/clj-watson {:local/root "."}}
                            :main-opts ["-m" "clj-watson.cli"]
                            :ns-default clj-watson.entrypoint}}}
